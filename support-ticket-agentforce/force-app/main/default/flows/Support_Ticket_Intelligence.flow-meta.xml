<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>

    <assignments>
        <name>Store_Account_Id</name>
        <label>Store Account Id</label>
        <assignmentItems>
            <assignToReference>varAccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Account.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Ticket</targetReference>
        </connector>
        <locationX>50</locationX>
        <locationY>240</locationY>
    </assignments>
    <assignments>
        <name>Store_Ticket_Id</name>
        <label>Store Ticket Id</label>
        <assignmentItems>
            <assignToReference>varTicketId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Ticket.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_SLA_Risk</targetReference>
        </connector>
        <locationX>50</locationX>
        <locationY>480</locationY>
    </assignments>
    <assignments>
        <name>Set_Priority_High</name>
        <label>Set Priority High</label>
        <assignmentItems>
            <assignToReference>varPriorityLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>High</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Priority</targetReference>
        </connector>
        <locationX>50</locationX>
        <locationY>720</locationY>
    </assignments>
    <assignments>
        <name>Set_Priority_Medium</name>
        <label>Set Priority Medium</label>
        <assignmentItems>
            <assignToReference>varPriorityLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Medium</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Priority</targetReference>
        </connector>
        <locationX>240</locationX>
        <locationY>720</locationY>
    </assignments>
    <assignments>
        <name>Set_Priority_Low</name>
        <label>Set Priority Low</label>
        <assignmentItems>
            <assignToReference>varPriorityLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Low</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Priority</targetReference>
        </connector>
        <locationX>430</locationX>
        <locationY>720</locationY>
    </assignments>
    <assignments>
        <name>Set_Assigned_Agent</name>
        <label>Set Assigned Agent</label>
        <assignmentItems>
            <assignToReference>varAssignedTo</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Senior Support Agent</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_Final_Message</targetReference>
        </connector>
        <locationX>50</locationX>
        <locationY>1080</locationY>
    </assignments>
    <assignments>
        <name>Message_High</name>
        <label>Message High</label>
        <assignmentItems>
            <assignToReference>varActionMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>High priority ticket detected. Assigned to senior agent.</stringValue>
            </value>
        </assignmentItems>
        <locationX>40</locationX>
        <locationY>1320</locationY>
    </assignments>
    <assignments>
        <name>Message_Medium</name>
        <label>Message Medium</label>
        <assignmentItems>
            <assignToReference>varActionMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Ticket marked as medium priority. Will be handled shortly.</stringValue>
            </value>
        </assignmentItems>
        <locationX>240</locationX>
        <locationY>1320</locationY>
    </assignments>
    <assignments>
        <name>Message_Low</name>
        <label>Message Low</label>
        <assignmentItems>
            <assignToReference>varActionMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tickets are low priority and queued for processing.</stringValue>
            </value>
        </assignmentItems>
        <locationX>440</locationX>
        <locationY>1320</locationY>
    </assignments>

    <decisions>
        <name>Analyze_Description</name>
        <label>Analyze Description</label>
        <defaultConnectorLabel>Low Priority</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Set_Priority_Low</targetReference>
        </defaultConnector>
        <rules>
            <name>High_Priority</name>
            <label>High Priority</label>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Ticket.Description__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>urgent</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Ticket.Description__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>not working</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Ticket.Description__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>failure</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Priority_High</targetReference>
            </connector>
        </rules>
        <rules>
            <name>Medium_Priority</name>
            <label>Medium Priority</label>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Ticket.Description__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>issue</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Ticket.Description__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>slow</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Ticket.Description__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>delay</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Priority_Medium</targetReference>
            </connector>
        </rules>
        <locationX>50</locationX>
        <locationY>600</locationY>
    </decisions>
    <decisions>
        <name>Check_SLA_Risk</name>
        <label>Check SLA Risk</label>
        <defaultConnectorLabel>Within SLA</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Analyze_Description</targetReference>
        </defaultConnector>
        <rules>
            <name>SLA_At_Risk</name>
            <label>SLA At Risk</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Ticket.Created_Date__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>SLA_Cutoff</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Flag_SLA_Risk</targetReference>
            </connector>
        </rules>
        <locationX>290</locationX>
        <locationY>600</locationY>
    </decisions>
    <decisions>
        <name>Is_High_Priority</name>
        <label>Is High Priority</label>
        <defaultConnectorLabel>Not High Priority</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Set_Final_Message</targetReference>
        </defaultConnector>
        <rules>
            <name>High_Priority_Confirmed</name>
            <label>High Priority Confirmed</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varPriorityLevel</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Task</targetReference>
            </connector>
        </rules>
        <locationX>50</locationX>
        <locationY>840</locationY>
    </decisions>
    <decisions>
        <name>Set_Final_Message</name>
        <label>Set Final Message</label>
        <defaultConnectorLabel>Low</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Message_Low</targetReference>
        </defaultConnector>
        <rules>
            <name>High</name>
            <label>High</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varPriorityLevel</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Message_High</targetReference>
            </connector>
        </rules>
        <rules>
            <name>Medium</name>
            <label>Medium</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varPriorityLevel</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Medium</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Message_Medium</targetReference>
            </connector>
        </rules>
        <locationX>50</locationX>
        <locationY>1200</locationY>
    </decisions>

    <description>Auto-launched flow invoked by the Agentforce Support Ticket Priority topic. Fetches the account and its latest support ticket, predicts priority from description keywords, creates a task for high-priority tickets, assigns an agent, and returns an action message.</description>

    <formulas>
        <name>SLA_Cutoff</name>
        <dataType>Date</dataType>
        <description>Anything raised before this date is at risk of breaching the two-day SLA.</description>
        <expression>{!$Flow.CurrentDate} - 2</expression>
    </formulas>

    <interviewLabel>Support Ticket Intelligence {!$Flow.CurrentDateTime}</interviewLabel>

    <label>Support Ticket Intelligence</label>

    <processType>AutoLaunchedFlow</processType>

    <recordCreates>
        <name>Create_Task</name>
        <label>Create Task</label>
        <object>Task</object>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Urgent Ticket Handling</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>varTicketId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <connector>
            <targetReference>Set_Assigned_Agent</targetReference>
        </connector>
        <locationX>50</locationX>
        <locationY>960</locationY>
    </recordCreates>

    <recordLookups>
        <name>Get_Account</name>
        <label>Get Account</label>
        <object>Account</object>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varAccountName</elementReference>
            </value>
        </filters>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <connector>
            <targetReference>Store_Account_Id</targetReference>
        </connector>
        <locationX>50</locationX>
        <locationY>120</locationY>
    </recordLookups>
    <recordLookups>
        <name>Get_Ticket</name>
        <label>Get Ticket</label>
        <object>Support_Ticket_Intelligence__c</object>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Customer__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varAccountId</elementReference>
            </value>
        </filters>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <connector>
            <targetReference>Store_Ticket_Id</targetReference>
        </connector>
        <locationX>50</locationX>
        <locationY>360</locationY>
    </recordLookups>

    <recordUpdates>
        <name>Flag_SLA_Risk</name>
        <label>Flag SLA Risk</label>
        <object>Support_Ticket_Intelligence__c</object>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varTicketId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>SLA_Breach_Risk__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <connector>
            <targetReference>Analyze_Description</targetReference>
        </connector>
        <locationX>290</locationX>
        <locationY>720</locationY>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Priority</name>
        <label>Update Priority</label>
        <object>Support_Ticket_Intelligence__c</object>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varTicketId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Priority_Level__c</field>
            <value>
                <elementReference>varPriorityLevel</elementReference>
            </value>
        </inputAssignments>
        <connector>
            <targetReference>Is_High_Priority</targetReference>
        </connector>
        <locationX>50</locationX>
        <locationY>840</locationY>
    </recordUpdates>

    <start>
        <connector>
            <targetReference>Get_Account</targetReference>
        </connector>
        <locationX>50</locationX>
        <locationY>0</locationY>
    </start>

    <status>Active</status>

    <variables>
        <name>varAccountName</name>
        <dataType>String</dataType>
        <description>Name of the customer account whose latest ticket should be analysed.</description>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varAccountId</name>
        <dataType>String</dataType>
        <description>Unique identifier of the resolved customer account.</description>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varTicketId</name>
        <dataType>String</dataType>
        <description>Unique identifier of the analysed support ticket.</description>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varPriorityLevel</name>
        <dataType>String</dataType>
        <description>Predicted priority level: High, Medium or Low.</description>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varAssignedTo</name>
        <dataType>String</dataType>
        <description>Support agent or team assigned to handle the ticket.</description>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>varActionMessage</name>
        <dataType>String</dataType>
        <description>Final message describing the action taken, returned to the agent.</description>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
